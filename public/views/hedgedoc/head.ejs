<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<meta name="mobile-web-app-capable" content="yes">
<%- include('../includes/favicon') %>
<% if (typeof menmenCustomUI !== 'undefined' && menmenCustomUI) {
  var menmenCssVersion = (typeof menmenAssetVersion !== 'undefined' && menmenAssetVersion) ? menmenAssetVersion : '2026091103';
%>
<link rel="stylesheet" href="<%- serverURL %>/css/menmen-custom.css?v=<%= menmenCssVersion %>-2026101309">
<link rel="stylesheet" href="<%- serverURL %>/css/menmen-drawio.css?v=<%= menmenCssVersion %>-drawio10">
<style nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
/* 首屏内联：不依赖 CSS 文件缓存，无编辑权默认不画分栏/铅笔 */
body.menmen-custom-ui .ui-mode-group,
body.menmen-custom-ui .ui-mode,
html.menmen-readonly .ui-mode-group,
html.menmen-readonly .ui-mode { display: none !important; }
body.menmen-custom-ui.menmen-can-edit:not(.menmen-readonly) .ui-mode-group,
html.menmen-can-edit:not(.menmen-readonly) .ui-mode-group { display: inline-block !important; vertical-align: middle; }
body.menmen-custom-ui.menmen-can-edit:not(.menmen-readonly) .ui-mode,
html.menmen-can-edit:not(.menmen-readonly) .ui-mode { display: inline-block !important; }
</style>
<!-- 同源 drawio-web 为 app.min.js 入口，无 js/bootstrap.js（预加载错误 URL 会 404） -->
<link rel="preload" href="<%- serverURL %>/drawio/js/app.min.js" as="script">
<link rel="preload" href="<%- serverURL %>/drawio/styles/grapheditor.css" as="style">
<% } %>
<% for (var og in opengraph) { %>
<% if (opengraph.hasOwnProperty(og) && String(opengraph[og]).trim() !== '') { %>
<meta property="og:<%= og %>" content="<%= String(opengraph[og]) %>">
<% }} if (!opengraph.hasOwnProperty('image')) { %>
<meta property="og:image" content="<%- serverURL %>/icons/android-chrome-512x512.png">
<meta property="og:image:alt" content="HedgeDoc logo">
<meta property="og:image:type" content="image/png">
<% } %>
<base href="<%- serverURL %>/">
<title><%= title %></title>
<link rel="stylesheet" href='<%- serverURL %>/build/emojify.js/dist/css/basic/emojify.min.css'>
<%- include('../build/index-pack-header') %>
